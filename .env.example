# The agent needs at least one of the providers below. Both speak the
# OpenAI chat-completions format, so they share one client; only the key,
# base URL, and model name differ.
#
# Endpoints are tried in the order OpenRouter -> Groq, and the client moves
# to the next one when a provider's free-tier quota is spent, so a long run
# doesn't stop at the first exhausted tier. Any provider you leave blank is
# simply skipped.
#
# Every *_API_KEY also has an *_API_KEYS plural form taking a comma-separated
# list, for holding several accounts' keys on the same provider.

# ~50 requests/day per account on the free tier (no added credit).
OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_API_KEYS=sk-or-v1-aaa...,sk-or-v1-bbb...
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Backup tier, and far roomier than OpenRouter's (~1000 requests/day per
# model, with a separate tokens-per-minute limit).
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
