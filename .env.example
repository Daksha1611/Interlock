# Single key:
OPENROUTER_API_KEY=sk-or-v1-...

# OR multiple keys (comma-separated, no spaces) to rotate to the next one
# when a key hits OpenRouter's free-tier daily cap (50 req/day per account
# without added credit). Takes precedence over OPENROUTER_API_KEY if set.
# OPENROUTER_API_KEYS=sk-or-v1-aaa...,sk-or-v1-bbb...,sk-or-v1-ccc...

OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
